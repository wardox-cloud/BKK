<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/keyboard"
    android:orientation="vertical"
    android:paddingStart="8dp"
    android:paddingTop="6dp"
    android:paddingEnd="8dp"
    android:paddingBottom="4dp">

    <TextView
        android:id="@+id/status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:maxLines="3"
        android:minHeight="36dp"
        android:paddingHorizontal="12dp"
        android:textColor="@color/muted"
        android:textSize="14sp" />

    <HorizontalScrollView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/styles"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal" />
    </HorizontalScrollView>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="124dp">

        <View
            android:id="@+id/level"
            android:layout_width="88dp"
            android:layout_height="88dp"
            android:layout_gravity="center"
            android:alpha="0"
            android:background="@drawable/mic_button" />

        <FrameLayout
            android:id="@+id/mic"
            android:layout_width="88dp"
            android:layout_height="88dp"
            android:layout_gravity="center"
            android:background="@drawable/mic_button"
            android:clickable="true"
            android:contentDescription="@string/mic"
            android:elevation="4dp"
            android:focusable="true">

            <ImageView
                android:id="@+id/mic_icon"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_mic" />

            <ProgressBar
                android:id="@+id/spinner"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_gravity="center"
                android:indeterminate="true"
                android:indeterminateTint="@color/on_accent"
                android:visibility="gone" />
        </FrameLayout>
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/switch_keyboard"
            style="@style/Murmur.KeyButton"
            android:contentDescription="@string/switch_keyboard"
            android:src="@drawable/ic_keyboard" />

        <ImageButton
            android:id="@+id/undo"
            style="@style/Murmur.KeyButton"
            android:contentDescription="@string/undo"
            android:src="@drawable/ic_undo" />

        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <ImageButton
            android:id="@+id/backspace"
            style="@style/Murmur.KeyButton"
            android:contentDescription="@string/backspace"
            android:src="@drawable/ic_backspace" />

        <ImageButton
            android:id="@+id/enter"
            style="@style/Murmur.KeyButton"
            android:contentDescription="@string/enter"
            android:src="@drawable/ic_enter" />
    </LinearLayout>
</LinearLayout>
