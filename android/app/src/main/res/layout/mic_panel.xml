<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/panel_background"
        android:elevation="12dp"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingTop="20dp"
        android:paddingBottom="28dp">

        <TextView
            android:id="@+id/panel_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/listening_start"
            android:textColor="@color/text"
            android:textSize="16sp" />

        <FrameLayout
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:layout_marginTop="8dp">

            <View
                android:id="@+id/panel_level"
                android:layout_width="84dp"
                android:layout_height="84dp"
                android:layout_gravity="center"
                android:alpha="0.3"
                android:background="@drawable/mic_button" />

            <FrameLayout
                android:id="@+id/panel_stop"
                android:layout_width="84dp"
                android:layout_height="84dp"
                android:layout_gravity="center"
                android:background="@drawable/mic_button"
                android:clickable="true"
                android:contentDescription="@string/panel_stop"
                android:focusable="true">

                <ImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_stop" />
            </FrameLayout>
        </FrameLayout>

        <TextView
            android:id="@+id/panel_cancel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:padding="10dp"
            android:text="@string/panel_cancel"
            android:textColor="@color/accent"
            android:textStyle="bold" />
    </LinearLayout>
</FrameLayout>
